# #######################################
# METRIC VIEWS
# #######################################
CREATE OR REPLACE METRIC VIEW metric_view_loan_officer_performance
    FOLDER = '/3 - data products/metric views'
    DESCRIPTION = 'Provides loan portfolio metrics by loan officer, including the number of loans managed, total loan amount, and average loan amount. Used to compare loan distribution and workload across loan officers. Does not measure officer effectiveness or loan profitability without additional business rules and performance data.' 
     (
    loan_identifier (description = 'loan_identifier identifies the individual loan represented in the performance metrics, supporting loan-level reference within the view. Example: 1, 11.'),
    customer_identifier (description = 'customer_identifier identifies the customer associated with the loan, enabling attribution of loan activity to a customer record. Example: 1, 11.'),
    loan_term (description = 'loan_term represents the duration of the loan in the term unit recorded by the source loan data, such as 10 or 30.'),
    property_identifier (description = 'property_identifier references the property associated with the loan when a property is linked to the loan record. Example: 1, 11.'),
    loan_status (description = 'loan_status indicates the current business state of the loan, such as whether it has been approved, rejected, or is pending. Example: approved.'),
    loan_origination_date (description = 'loan_origination_date specifies the date on which the loan was originated, with sample values such as 2021-03-15 and 2022-04-03.'),
    loan_officer_identifier (description = 'loan_officer_identifier identifies the loan officer responsible for or associated with the loan and related performance metrics. Example: 1, 11.'),
    loan_officer_first_name (description = 'loan_officer_first_name contains the loan officer’s first name as recorded for officer identification and reporting, such as Mark or Michael.'),
    loan_officer_last_name (description = 'loan_officer_last_name contains the loan officer’s last name as recorded for officer identification and reporting, such as Brown or Taylor.'),
    loan_officer_email (description = 'loan_officer_email contains the loan officer’s email address for contact and officer reference information. Example: mark.taylor@example.com, michael.brown@example.com.'),
    loan_officer_phone_number (description = 'loan_officer_phone_number contains the loan officer’s phone number for contact reference information, such as 555-123-4567.'),
    managed_loan_count (description = 'managed_loan_count measures the number of distinct loans managed, expressed in loans.'),
    managed_loan_total_amount (description = 'managed_loan_total_amount measures the total value of managed loans, expressed in the monetary unit recorded for loan_amount.'),
    average_managed_loan_amount (description = 'average_managed_loan_amount measures the average value of managed loans, expressed in the monetary unit recorded for loan_amount.')
 )
SOURCES (
        loans AS loans,
        loan_officers AS loan_officers    
    )
    ASSOCIATIONS (
        loan_officers loans bank_loanofficers_bank_loans    
    )
    DIMENSIONS (
        loans(
            loan_identifier AS loans.loan_id,
            customer_identifier AS loans.customer_id,
            loan_term AS loans.term,
            property_identifier AS loans.property_id,
            loan_status AS loans.status,
            loan_origination_date AS loans.date_created
        ),
        loan_officers(
            loan_officer_identifier AS loan_officers.loan_officer_id,
            loan_officer_first_name AS loan_officers.first_name,
            loan_officer_last_name AS loan_officers.last_name,
            loan_officer_email AS loan_officers.email,
            loan_officer_phone_number AS loan_officers.phone_number
        )    
    )
    METRICS (
        managed_loan_count AS count(DISTINCT loans.loan_id),
        managed_loan_total_amount AS sum(loans.loan_amount),
        average_managed_loan_amount AS avg(loans.loan_amount)    
    )
;

ALTER VIEW metric_view_loan_officer_performance
 LAYOUT (loans = [470, 129, 40, 80], loan_officers = [89, 74, 40, 80]);

CREATE OR REPLACE METRIC VIEW metric_view_loan_payments
    FOLDER = '/3 - data products/metric views'
    DESCRIPTION = 'Provides loan payment metrics, including total payments, total payment amount, and average payment amount. Used to analyze payment activity by payment date, loan status, and customer.' 
     (
    loan_id (description = 'loan_id identifies the loan associated with the payment metrics and connects payment activity to an individual loan record. Example: 3, 12.'),
    customer_id (description = 'customer_id identifies the customer associated with the loan and its related payment metrics. Example: 3, 12.'),
    term (description = 'term represents the duration assigned to the loan, captured as a numeric value from the loan record; the metadata does not specify the time unit. Sample values include 20 and 25.'),
    property_id (description = 'property_id identifies the property associated with the loan when a property reference is available. Example: 3, 12.'),
    loan_officer_id (description = 'loan_officer_id identifies the loan officer associated with managing the loan application. Example: 11, 12.'),
    status (description = 'status indicates the current business state of the loan, such as whether it is approved or awaiting a decision. Example: approved, pending.'),
    date_created (description = 'date_created records the date when the loan was originated. Sample values include 2023-02-14 and 2023-07-10.'),
    payment_id (description = 'payment_id identifies an individual loan payment transaction included in the payment metrics. Example: 3, 12.'),
    payment_date (description = 'payment_date records the date on which a loan payment was made. Sample values include 2024-03-01 and 2024-12-01.'),
    total_payments (description = 'total_payments is the count of distinct loan payment transactions, measured in payments.'),
    total_payment_amount (description = 'total_payment_amount is the summed value of loan payment amounts, measured in the source payment amount unit.'),
    average_payment_amount (description = 'average_payment_amount is the average value of loan payment amounts, measured in the source payment amount unit.')
 )
SOURCES (
        loans AS loans,
        loan_payments AS loan_payments    
    )
    ASSOCIATIONS (
        loans loan_payments bank_loans_bank_payments    
    )
    DIMENSIONS (
        loans(
            loan_id AS loans.loan_id,
            customer_id AS loans.customer_id,
            term AS loans.term,
            property_id AS loans.property_id,
            loan_officer_id AS loans.loan_officer_id,
            status AS loans.status,
            date_created AS loans.date_created
        ),
        loan_payments(
            payment_id AS loan_payments.payment_id,
            payment_date AS loan_payments.payment_date
        )    
    )
    METRICS (
        total_payments AS count(DISTINCT loan_payments.payment_id),
        total_payment_amount AS sum(loan_payments.payment_amount),
        average_payment_amount AS avg(loan_payments.payment_amount)    
    )
;

ALTER VIEW metric_view_loan_payments
 LAYOUT (loans = [20, 20, 200, 200], loan_payments = [378, 55, 40, 80]);

CREATE OR REPLACE METRIC VIEW metric_view_loan_portfolio
    FOLDER = '/3 - data products/metric views'
    DESCRIPTION = 'Provides aggregated loan portfolio metrics, including total loan count, total loan amount, average loan amount, loan count by status, and average interest rate. Used for monitoring and comparing loan portfolio performance across available dimensions. For individual loan details, use the loans data product.' 
     (
    loan_id (description = 'Identifies the loan represented within the loan portfolio metrics, enabling metrics to be related back to a specific loan record when present. Example: 4, 16.'),
    customer_id (description = 'Identifies the customer associated with the loan, supporting customer-level grouping or interpretation of loan portfolio metrics. Example: 4, 16.'),
    term (description = 'Represents the recorded duration of the loan; the metadata does not specify the time unit. It helps describe the loan structure within the portfolio metrics.'),
    property_id (description = 'Identifies the property associated with the loan when a property relationship is recorded. Example: 4, 16.'),
    loan_officer_id (description = 'Identifies the loan officer associated with managing the loan application. Example: 4, 16.'),
    status (description = 'Indicates the current loan status, such as whether the loan is pending, approved, or rejected. Example: pending.'),
    date_created (description = 'Specifies the date when the loan was originated or created in the loan portfolio data. Example values include 2021-09-12 and 2021-11-25.'),
    total_loans (description = 'Represents the count of distinct loans included in the metric context. Unit: loans.'),
    total_loan_amount (description = 'Represents the summed loan amount across the loans included in the metric context. Unit: loan amount currency as stored in the source data.'),
    average_loan_amount (description = 'Represents the average loan amount across the loans included in the metric context. Unit: loan amount currency as stored in the source data.'),
    loan_count (description = 'Represents the count of distinct loans included in the metric context. Unit: loans.'),
    average_interest_rate (description = 'Represents the average interest rate across the loans included in the metric context. Unit: interest rate as stored in the source data.')
 )
SOURCES (
        loans AS loans    
    )
    DIMENSIONS (
        loans(
            loan_id AS loans.loan_id,
            customer_id AS loans.customer_id,
            term AS loans.term,
            property_id AS loans.property_id,
            loan_officer_id AS loans.loan_officer_id,
            status AS loans.status,
            date_created AS loans.date_created
        )    
    )
    METRICS (
        total_loans AS count(DISTINCT loans.loan_id),
        total_loan_amount AS sum(loans.loan_amount),
        average_loan_amount AS avg(loans.loan_amount),
        loan_count AS count(DISTINCT loans.loan_id),
        average_interest_rate AS avg(loans.interest_rate)    
    )
;

ALTER VIEW metric_view_loan_portfolio
 LAYOUT (loans = [20, 20, 200, 200]);

# #######################################
# WEBSERVICES
# #######################################
CREATE OR REPLACE REST WEBSERVICE bank_demo_rest_ws
    CONNECTION (
        CHUNKSIZE = 1000
        CHUNKTIMEOUT = 90000
        QUERYTIMEOUT = 900000
        POOLENABLED = true
        POOLINITSIZE = 0
        POOLMAXACTIVE = 30
    )
    DEFAULTREPRESENTATION = HTML
    SUPPORTEDREPRESENTATIONS (HTML, XML, JSON)    AUTHENTICATION (BASIC VDP )

    RESOURCES (
        VIEW accounts FIELDS (
            account_id : 'int', 
            customer_id : 'int', 
            account_type : 'text', 
            balance : 'double', 
            date_created : 'localdate'
        ),
        VIEW loan_officers FIELDS (
            loan_officer_id : 'int', 
            first_name : 'text', 
            last_name : 'text', 
            email : 'text', 
            phone_number : 'text'
        ),
        VIEW loans FIELDS (
            loan_id : 'int', 
            customer_id : 'int', 
            loan_amount : 'double', 
            interest_rate : 'double', 
            term : 'int', 
            property_id : 'int', 
            loan_officer_id : 'int', 
            status : 'text', 
            date_created : 'localdate'
        ),
        VIEW loan_payments FIELDS (
            payment_id : 'int', 
            loan_id : 'int', 
            payment_amount : 'double', 
            payment_date : 'text'
        ),
        VIEW properties FIELDS (
            property_id : 'int', 
            address : 'text', 
            city : 'text', 
            state : 'text', 
            zip_code : 'text', 
            property_value : 'double'
        ),
        VIEW loan_rates FIELDS (
            rate_id : 'int', 
            loan_type : 'text', 
            term : 'int', 
            interest_rate : 'double'
        ),
        VIEW loan_underwriting FIELDS (
            underwriting_id : 'int', 
            loan_id : 'int', 
            credit_score : 'int', 
            employment_history : 'text', 
            financial_history : 'text'
        )
    )
    ASSOCIATIONS ( bank_loans_bank_payments, bank_loans_bank_underwriting, bank_properties_bank_loans )
    OPTIONS ( NULLVALUESASEMPTYXMLELEMENTS = false
        MAX_ROWS_PER_PAGE = 25
        PROCESS_FUNCTIONS_IN_SELECT_PARAMETER = true ) 
    OPENAPI2 ( API_VERSION = '1.0.0' ) 
    FOLDER = '/5 - data services';

CHOWN admin WEBSERVICE bank_demo_rest_ws LASTMODIFICATIONUSER admin;

# #######################################
# WEBCONTAINER WEB SERVICE DEPLOYMENTS
# #######################################
UNDEPLOY IF EXISTS WEBSERVICE bank_demo_rest_ws;

DEPLOY WEBSERVICE bank_demo_rest_ws;

