CHOWN admin ASSOCIATION bv_bank_loans_bv_bank_payments LASTMODIFICATIONUSER admin;

CREATE OR REPLACE ASSOCIATION bv_bank_loans_bv_bank_underwriting REFERENTIAL CONSTRAINT 
