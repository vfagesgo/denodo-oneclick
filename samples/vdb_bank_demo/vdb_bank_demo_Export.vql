CREATE OR REPLACE TABLE bv_accounts I18N us_pst (
        acct_id:int (notnull, sourcetypeid = '4', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '10', description = 'A unique identifier for each bank account.'),
        customer_id:int (sourcetypeid = '4', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '10', description = 'A reference to the customer who owns the bank account.'),
        acct_type:text (sourcetypeid = '-9', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '256', description = 'The type of bank account (e.g., savings, checking).'),
        balance:double (sourcetypeid = '7', sourcetyperadix = '10', sourcetypedecimals = '8', sourcetypesize = '8', description = 'The current balance of the bank account.'),
        date_created:localdate (sourcetypeid = '91', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '13', description = 'The date the account was created, typically in the format ''YYYY-MM-DD''.')
    )
    FOLDER = '/1 - connectivity/2 - base views'
    DESCRIPTION = 'bv_bank_accounts is designed to hold information about the bank’s accounts, including details on account types, balances, and creation dates.'
    CONSTRAINT 'Acct_pkey' PRIMARY KEY ( 'acct_id' )
    CACHE OFF
    TIMETOLIVEINCACHE DEFAULT
    ADD SEARCHMETHOD bv_bank_acct(
        I18N us_pst
        CONSTRAINTS (
             ADD acct_id (any) OPT ANY
             ADD customer_id (any) OPT ANY
             ADD acct_type (any) OPT ANY
             ADD balance (any) OPT ANY
             ADD date_created (any) OPT ANY
