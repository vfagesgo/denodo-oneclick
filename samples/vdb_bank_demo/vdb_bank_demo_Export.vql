# #######################################
CREATE OR REPLACE ASSOCIATION bank_customers_bank_acct REFERENTIAL CONSTRAINT 
FOLDER = '/6 - associations'
    ENDPOINT bank_acct customers PRINCIPAL (0,1)
    ENDPOINT bank_customers accounts (0,*)
    ADD MAPPING customer_id=customer_id;

CHOWN admin ASSOCIATION bank_customers_bank_acct LASTMODIFICATIONUSER admin;

CREATE OR REPLACE ASSOCIATION bank_customers_bank_loans REFERENTIAL CONSTRAINT 
FOLDER = '/6 - associations'
    ENDPOINT bank_loans customers PRINCIPAL (0,1)
    ENDPOINT bank_customers loans (0,*)
    ADD MAPPING customer_id=customer_id;

CHOWN admin ASSOCIATION bank_customers_bank_loans LASTMODIFICATIONUSER admin;

CREATE OR REPLACE ASSOCIATION bank_loanofficers_bank_loans REFERENTIAL CONSTRAINT 
FOLDER = '/6 - associations'
    ENDPOINT bank_loans loan_officers PRINCIPAL (0,1)
    ENDPOINT bank_loanofficers loans (0,*)
    ADD MAPPING loan_officer_id=loan_officer_id;

CHOWN admin ASSOCIATION bank_loanofficers_bank_loans LASTMODIFICATIONUSER admin;

CREATE OR REPLACE ASSOCIATION bank_loans_bank_payments REFERENTIAL CONSTRAINT 
FOLDER = '/6 - associations'
    ENDPOINT bank_payments loans PRINCIPAL (0,1)
    ENDPOINT bank_loans loan_payments (0,*)
    ADD MAPPING loan_id=loan_id;

CHOWN admin ASSOCIATION bank_loans_bank_payments LASTMODIFICATIONUSER admin;

CREATE OR REPLACE ASSOCIATION bank_loans_bank_underwriting REFERENTIAL CONSTRAINT 
FOLDER = '/6 - associations'
    ENDPOINT bank_underwriting loans PRINCIPAL (0,1)
    ENDPOINT bank_loans loan_underwriting (0,*)
    ADD MAPPING loan_id=loan_id;

CHOWN admin ASSOCIATION bank_loans_bank_underwriting LASTMODIFICATIONUSER admin;

CREATE OR REPLACE ASSOCIATION bank_properties_bank_loans REFERENTIAL CONSTRAINT 
FOLDER = '/6 - associations'
    ENDPOINT bank_loans properties PRINCIPAL (0,1)
    ENDPOINT bank_properties loans (0,*)
    ADD MAPPING property_id=property_id;

CHOWN admin ASSOCIATION bank_properties_bank_loans LASTMODIFICATIONUSER admin;

CREATE OR REPLACE ASSOCIATION bv_bank_customers_bv_bank_acct REFERENTIAL CONSTRAINT 
FOLDER = '/6 - associations'
    ENDPOINT bv_bank_acct bv_customers PRINCIPAL (0,1)
    ENDPOINT bv_bank_customers bv_accounts (0,*)
    ADD MAPPING customer_id=customer_id;

CHOWN admin ASSOCIATION bv_bank_customers_bv_bank_acct LASTMODIFICATIONUSER admin;

CREATE OR REPLACE ASSOCIATION bv_bank_customers_bv_bank_loans REFERENTIAL CONSTRAINT 
FOLDER = '/6 - associations'
    ENDPOINT bv_bank_loans bv_customers PRINCIPAL (0,1)
    ENDPOINT bv_bank_customers bv_loans (0,*)
    ADD MAPPING customer_id=customer_id;

CHOWN admin ASSOCIATION bv_bank_customers_bv_bank_loans LASTMODIFICATIONUSER admin;

CREATE OR REPLACE ASSOCIATION bv_bank_loanofficers_bv_bank_loans REFERENTIAL CONSTRAINT 
FOLDER = '/6 - associations'
    ENDPOINT bv_bank_loans bv_loanofficers PRINCIPAL (0,1)
    ENDPOINT bv_bank_loanofficers bv_loans (0,*)
    ADD MAPPING loan_officer_id=loan_officer_id;

CHOWN admin ASSOCIATION bv_bank_loanofficers_bv_bank_loans LASTMODIFICATIONUSER admin;

CREATE OR REPLACE ASSOCIATION bv_bank_loans_bv_bank_payments REFERENTIAL CONSTRAINT 
FOLDER = '/6 - associations'
    ENDPOINT bv_bank_payments bv_loans PRINCIPAL (0,1)
    ENDPOINT bv_bank_loans bv_payments (0,*)
