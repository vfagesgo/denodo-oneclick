# #######################################
# VIEWS
# #######################################
CREATE OR REPLACE INTERFACE VIEW accounts (
        account_id:int (description = 'A unique identifier for each bank account.') TAGS (pii_data),
        customer_id:int (sourcetypedecimals = '0', sourcetyperadix = '10', sourcetypesize = '10', description = 'A reference to the customer who owns the bank account.', sourcetypeid = '4') TAGS (pii_data),
        account_type:text (description = 'The type of bank account (e.g., savings, checking).'),
        balance:double (sourcetypedecimals = '8', sourcetyperadix = '10', sourcetypesize = '8', description = 'The current balance of the bank account.', sourcetypeid = '7'),
        date_created:localdate
    )
    SET IMPLEMENTATION bv_accounts(
        account_id = acct_id,
        customer_id = customer_id,
        account_type = acct_type,
        balance = balance,
        date_created = date_created    
)
    FOLDER = '/3 - data products'
    DESCRIPTION = 'Represents bank account records, with one row per account. Use this view to count accounts, analyze account distribution by type, summarize recorded balances, and analyze account creation trends. Do not use it to determine customer-level profiles, loan details, or payment history, as these are outside the view''s scope. The customer_id field can be used to join with the customer data product through the corresponding customer identifier, subject to a defined association and validated referential integrity.' 
    TAGS (ai_banking);

CREATE OR REPLACE INTERFACE VIEW customers (
        customer_id:long (sourcetypedecimals = '0', sourcetyperadix = '0', sourcetypesize = '10', description = 'Represents a unique identifier for each customer in the bank system, facilitating the tracking and management of customer accounts.', sourcetypeid = '-5'),
        first_name:text (sourcetypedecimals = '0', sourcetyperadix = '0', sourcetypesize = '256', description = 'Stores the first name of the customer, which is essential for personalization and identification purposes.', sourcetypeid = '-9'),
        last_name:text (sourcetypedecimals = '0', sourcetyperadix = '0', sourcetypesize = '256', description = 'Contains the last name of the customer, helping to uniquely identify individuals within the bank''s customer database.', sourcetypeid = '-9') TAGS (pii_data),
        email:text (sourcetypedecimals = '0', sourcetyperadix = '0', sourcetypesize = '256', description = 'Holds the customer''s email address, which is vital for communication and account-related notifications.', sourcetypeid = '-9') TAGS (pii_data),
        phone_number:text (sourcetypedecimals = '0', sourcetyperadix = '0', sourcetypesize = '256', description = 'Contains the customer''s phone number, allowing for direct contact and support-related inquiries.', sourcetypeid = '-9') TAGS (pii_data),
        address:text (sourcetypedecimals = '0', sourcetyperadix = '0', sourcetypesize = '256', description = 'Represents the residential address of the customer, necessary for account verification and correspondence.', sourcetypeid = '-9') TAGS (pii_data),
        city:text (sourcetypedecimals = '0', sourcetyperadix = '0', sourcetypesize = '256', description = 'Indicates the city where the customer resides, useful for demographic analysis and service delivery.', sourcetypeid = '-9'),
        state:text (sourcetypedecimals = '0', sourcetyperadix = '0', sourcetypesize = '256', description = 'Specifies the state of the customer''s residence, which can impact financial services and regulatory compliance.', sourcetypeid = '-9'),
        zip_code:text (sourcetypedecimals = '0', sourcetyperadix = '0', sourcetypesize = '256', description = 'Represents the postal code of the customer''s address, important for geographical identification and service localization.', sourcetypeid = '-9'),
        country:text (sourcetypedecimals = '0', sourcetyperadix = '0', sourcetypesize = '256', description = 'Stores the customer''s country of residence, relevant for international services and compliance with local laws.', sourcetypeid = '-9') TAGS (country_classification_tag),
        dob:localdate (sourcetypedecimals = '0', sourcetypesize = '0', description = 'Indicates the date of birth of the customer, which is important for age verification and demographic profiling.', sourcetypeid = '91', sourcetypename = 'DATE') TAGS (pii_data),
        sex:text (sourcetypedecimals = '0', sourcetyperadix = '0', sourcetypesize = '256', description = 'Represents the gender of the customer, useful for personalization of services and marketing strategies.', sourcetypeid = '-9'),
        loyalty_classification:text (sourcetypedecimals = '0', sourcetyperadix = '0', sourcetypesize = '256', description = 'Identifies the loyalty tier or classification of the customer, which can influence benefits and promotions offered.', sourcetypeid = '-9'),
        risk_weighting:long (sourcetypedecimals = '0', sourcetyperadix = '0', sourcetypesize = '10', description = 'Represents the risk assessment value assigned to the customer, important for compliance and lending decisions.', sourcetypeid = '-5'),
        income_band:text (sourcetypedecimals = '0', sourcetyperadix = '0', sourcetypesize = '256', description = 'Specifies the income range of the customer, relevant for tailored financial advice and product offerings.', sourcetypeid = '-9')
    )
    SET IMPLEMENTATION bv_customers
    FOLDER = '/3 - data products'
    DESCRIPTION = 'Represents customer records, with one row per customer, identified by customer_id (subject to validation of uniqueness).  Use this view to analyze customer distribution by location and retrieve customer information for authorized business use cases. Do not use it as the source of truth for account balances, loan details, or payment history, as these are outside the view''s scope. Customer-related joins should use customer_id with the corresponding customer identifier in associated data products, where a defined association exists.' 
    TAGS (ai_banking, mcp);

CREATE OR REPLACE INTERFACE VIEW loan_officers (
        loan_officer_id:int (sourcetypedecimals = '0', sourcetyperadix = '10', sourcetypesize = '10', description = 'A unique identifier for each loan officer.', sourcetypeid = '4'),
        first_name:text (sourcetypedecimals = '0', sourcetyperadix = '10', sourcetypesize = '256', description = 'The first name of the loan officer', sourcetypeid = '-9'),
        last_name:text (sourcetypedecimals = '0', sourcetyperadix = '10', sourcetypesize = '256', description = 'The last name of the loan officer', sourcetypeid = '-9'),
        email:text (sourcetypedecimals = '0', sourcetyperadix = '10', sourcetypesize = '256', description = 'The email of the loan officer', sourcetypeid = '-9'),
        phone_number:text (sourcetypedecimals = '0', sourcetyperadix = '10', sourcetypesize = '256', description = 'The phone number of the loan officer', sourcetypeid = '-9')
    )
    SET IMPLEMENTATION bv_loanofficers
    FOLDER = '/3 - data products'
    DESCRIPTION = 'Represents bank loan officers, with one row per loan officer, identified by loan_officer_id (subject to validation of uniqueness). Use this view to identify loan officers and retrieve their contact details for authorized business purposes. Do not use it to determine loan amounts, loan status, payment history, or individual loan performance without joining to the relevant data products. To analyze loans managed by each officer, join this view to the loans data product using loan_officer_id, where a defined association exists. ' 
    TAGS (ai_banking);

CREATE OR REPLACE INTERFACE VIEW loan_payments (
        payment_id:int (sourcetypedecimals = '0', sourcetyperadix = '10', sourcetypesize = '10', description = 'A unique identifier for each payment transaction.', sourcetypeid = '4'),
        loan_id:int (sourcetypedecimals = '0', sourcetyperadix = '10', sourcetypesize = '10', description = 'A reference to the loan for which the payment is made.', sourcetypeid = '4'),
        payment_amount:double (sourcetypedecimals = '8', sourcetyperadix = '10', sourcetypesize = '8', description = 'The amount of money paid in the transaction.', sourcetypeid = '7') TAGS (restricted_transaction_data),
        payment_date:text (sourcetypedecimals = '0', sourcetyperadix = '10', sourcetypesize = '256', description = 'The date on which the payment was made.', sourcetypeid = '-9')
    )
    SET IMPLEMENTATION bv_payments
    FOLDER = '/3 - data products'
    DESCRIPTION = 'Represents bank loan payment records, with one row per payment transaction. Used to analyze loan repayments, payment amounts, and payment activity over time. Not suitable for determining outstanding loan balances, overdue payments, or repayment status without additional loan information and business rules. Can be joined with the loans data product using the associated loan identifier.' 
    TAGS (ai_banking);

CREATE OR REPLACE INTERFACE VIEW loan_policy_knowledge (
        chunk_id:text,
        document_id:text,
        document_name:text,
        document_type:text,
        document_version:text,
        effective_date:localdate,
        page_number:int,
        chunk_text:text,
        content_hash:text,
        file_hash:text,
        access_classification:text,
        embedding:vector<float,1536> (embeddingmodel = 'text-embedding-3-small', sourcetyperadix = '10', sourcetypeid = '10006'),
        indexed_at:timestamptz
    )
    SET IMPLEMENTATION bv_loan_policy_knowledge
    FOLDER = '/3 - data products'
    DESCRIPTION = 'Contains extracted content from loan policy documents, including eligibility criteria, credit score requirements, affordability limits, loan-to-value ratios, documentation requirements, and approval procedures. Used for semantic search and AI-powered retrieval of relevant loan policy information.' 
    TAGS (ai_banking);

CREATE OR REPLACE INTERFACE VIEW loan_rates (
        rate_id:int (sourcetypedecimals = '0', sourcetyperadix = '10', sourcetypesize = '10', description = 'A unique identifier for each interest rate entry.', sourcetypeid = '4'),
        loan_type:text (sourcetypedecimals = '0', sourcetyperadix = '10', sourcetypesize = '256', description = 'The type of loan to which the interest rate applies', sourcetypeid = '-9'),
        term:int (sourcetypedecimals = '0', sourcetyperadix = '10', sourcetypesize = '10', description = 'The term length of the loan in years', sourcetypeid = '4'),
        interest_rate:double (sourcetypedecimals = '8', sourcetyperadix = '10', sourcetypesize = '8', description = 'The interest rate for the loan, expressed as a percentage.', sourcetypeid = '7')
    )
    SET IMPLEMENTATION bv_rates
    FOLDER = '/3 - data products'
    DESCRIPTION = 'Contains interest rates for different types of loans and loan durations. Used to compare interest rates for different loan types and terms. ' 
    TAGS (ai_banking);

CREATE OR REPLACE INTERFACE VIEW loan_underwriting (
        underwriting_id:int (sourcetypedecimals = '0', sourcetyperadix = '10', sourcetypesize = '10', sourcetypeid = '4'),
        loan_id:int (sourcetypedecimals = '0', sourcetyperadix = '10', sourcetypesize = '10', sourcetypeid = '4'),
        credit_score:int (sourcetypedecimals = '0', sourcetyperadix = '10', sourcetypesize = '10', sourcetypeid = '4'),
        employment_history:text (sourcetypedecimals = '0', sourcetyperadix = '10', sourcetypesize = '256', sourcetypeid = '-9'),
        financial_history:text (sourcetypedecimals = '0', sourcetyperadix = '10', sourcetypesize = '256', sourcetypeid = '-9')
    )
    SET IMPLEMENTATION bv_underwriting
    FOLDER = '/3 - data products'
    DESCRIPTION = 'Contains loan underwriting records used to assess the risk of lending to borrowers, including credit scores, employment history, and financial history. Used to review borrower information during the loan assessment process. Should not be used alone to determine loan approval or creditworthiness without the bank''s defined assessment criteria. Can be joined with the loans data product using the loan identifier.' 
    TAGS (ai_banking);

CREATE OR REPLACE INTERFACE VIEW loans (
        loan_id:int (sourcetypedecimals = '0', sourcetyperadix = '10', sourcetypesize = '10', description = 'A unique identifier for each loan.', sourcetypeid = '4'),
        customer_id:int (sourcetypedecimals = '0', sourcetyperadix = '10', sourcetypesize = '10', description = 'A unique identifier for each customer.', sourcetypeid = '4'),
        loan_amount:double (sourcetypedecimals = '8', sourcetyperadix = '10', sourcetypesize = '8', description = 'The total amount of money that has been loaned', sourcetypeid = '7') TAGS (restricted_transaction_data),
        interest_rate:double (sourcetypedecimals = '8', sourcetyperadix = '10', sourcetypesize = '8', description = 'The interest rate applied to the loan.', sourcetypeid = '7'),
        term:int (sourcetypedecimals = '0', sourcetyperadix = '10', sourcetypesize = '10', description = 'The duration of the loan', sourcetypeid = '4'),
        property_id:int (sourcetypedecimals = '0', sourcetyperadix = '10', sourcetypesize = '10', description = 'A reference to the property associated with the loan, if applicable.', sourcetypeid = '4'),
        loan_officer_id:int (sourcetypedecimals = '0', sourcetyperadix = '10', sourcetypesize = '10', description = 'A reference to the loan officer who managed the loan application.', sourcetypeid = '4'),
        status:text (sourcetypedecimals = '0', sourcetyperadix = '10', sourcetypesize = '256', description = 'The current status of the loan. Can be rejected, pending or approved.', sourcetypeid = '-9'),
        date_created:localdate (sourcetypedecimals = '0', sourcetyperadix = '10', sourcetypesize = '13', description = 'The date the loan was originated', sourcetypeid = '91')
    )
    SET IMPLEMENTATION bv_loans
    FOLDER = '/3 - data products'
    DESCRIPTION = 'Represents bank loan records, with one row per loan. Use this when you need individual loan records or detailed attributes. Not suitable for determining payment totals or outstanding balances without the relevant payment data and business rules. Can be joined with customers, loan officers, and properties through the corresponding identifiers, where associations are defined.' 
    TAGS (ai_banking);

CREATE OR REPLACE INTERFACE VIEW properties (
        property_id:int (sourcetypedecimals = '0', sourcetyperadix = '10', sourcetypesize = '10', description = 'A unique identifier for each property', sourcetypeid = '4'),
        address:text (sourcetypedecimals = '0', sourcetyperadix = '10', sourcetypesize = '256', description = 'The street address of the property', sourcetypeid = '-9'),
        city:text (sourcetypedecimals = '0', sourcetyperadix = '10', sourcetypesize = '256', description = 'The city in which the property is located.', sourcetypeid = '-9'),
        state:text (sourcetypedecimals = '0', sourcetyperadix = '10', sourcetypesize = '256', description = 'The state in which the property is located.', sourcetypeid = '-9'),
        zip_code:text (sourcetypedecimals = '0', sourcetyperadix = '10', sourcetypesize = '256', description = 'The postal code for the property’s location.', sourcetypeid = '-9'),
        property_value:double (sourcetypedecimals = '8', sourcetyperadix = '10', sourcetypesize = '8', description = 'The assessed value of the property in dollars', sourcetypeid = '7')
    )
    SET IMPLEMENTATION bv_properties
    FOLDER = '/3 - data products'
    DESCRIPTION = 'Represents property records, with one row per property. Used to analyze property locations and assessed values, including geographic distribution and property valuation trends. Not suitable for determining property ownership, loan details, or outstanding mortgage balances without additional data. Can be joined with the loans data product using the property identifier, where a defined association exists.' 
    TAGS (ai_banking);

CREATE OR REPLACE VIEW bank_properties_loans FOLDER = '/4 - report views' DESCRIPTION = 'Represents bank property records with associated loan information while retaining all property records. The row grain is a property with its related loan details where available,  This view can be used to review property-backed lending exposure, compare assessed property values with loan amounts, monitor loan statuses, and support reporting by property location or origination date. It should not be used when detailed customer or loan officer attributes are required, or when only loans with complete property matches are needed. No specific joins are defined.' 
    TAGS (mcp) AS SELECT bank_properties.property_id AS property_id, bank_properties.address AS address, bank_properties.city AS city, bank_properties.state AS state, bank_properties.zip_code AS zip_code, bank_properties.property_value AS property_value, bank_loans.customer_id AS customer_id, bank_loans.loan_id AS loan_id, bank_loans.loan_amount AS loan_amount, bank_loans.interest_rate AS interest_rate, bank_loans.term AS term, bank_loans.loan_officer_id AS loan_officer_id, bank_loans.status AS status, bank_loans.date_created AS date_created FROM properties AS bank_properties LEFT OUTER JOIN loans AS bank_loans ON bank_properties.property_id = bank_loans.property_id  ORDER BY property_id ASC;

ALTER VIEW bank_properties_loans
 LAYOUT (properties = [0, 0, 200, 200], loans = [474, 115, 200, 200]);

CHOWN admin VIEW bank_properties_loans LASTMODIFICATIONUSER admin;

CREATE OR REPLACE VIEW bank_properties_per_state FOLDER = '/4 - report views' DESCRIPTION = 'A view created from the bank_properties table that counts the number of properties in each state. This view provides a summary of property distribution across different states, allowing for quick insights into the concentration of properties in each region.' 
    TAGS (mcp) (
    count (description = 'The number of properties per state')
 )
 AS SELECT state AS state, count(*) AS count FROM properties GROUP BY state ORDER BY count DESC;

CHOWN admin VIEW bank_properties_per_state LASTMODIFICATIONUSER admin;

CREATE OR REPLACE VIEW bank_west_properties FOLDER = '/4 - report views' DESCRIPTION = 'A view created from the bank_properties table, including only the records where the properties are located in West Coast states. This view provides convenient access to properties specifically in California, Oregon, and Washington.
' 
    TAGS (mcp) AS SELECT properties.property_id AS property_id, properties.address AS address, properties.city AS city, properties.state AS state, properties.zip_code AS zip_code, properties.property_value AS property_value FROM properties WHERE state in ('CA', 'OR', 'WA');

CHOWN admin VIEW bank_west_properties LASTMODIFICATIONUSER admin;

CREATE OR REPLACE VIEW customer_payments FOLDER = '/4 - report views' DESCRIPTION = 'The customer_payments view is a comprehensive dataset that combines customer information, loan details, and payment records for a bank. It includes personal information such as customer ID, name, contact details, and address. The view also contains loan-related data such as loan amount, interest rate, term, and status. Additionally, it includes payment information like payment ID, amount, and date. The view also captures customer loyalty classification and country of residence.

This view serves multiple purposes within the banking context:

1. Customer Relationship Management: The view enables the bank to analyze customer profiles, contact information, and loyalty classifications. This information can be used to improve customer service, personalize offerings, and enhance overall customer experience. For example, the bank can use the email and phone number fields to communicate effectively with customers, while the loyalty_classification field can help in tailoring services to different customer segments.

2. Loan Portfolio Management: With detailed loan information such as loan_amount, interest_rate, term, and status, the bank can effectively monitor its lending activities and assess risk exposure. This data allows for a comprehensive overview of the loan portfolio, helping in strategic decision-making and risk management.

3. Payment Tracking: The payment_id, payment_amount, and payment_date fields enable the bank to track customer payments accurately. This information is crucial for managing cash flow, identifying potential issues with loan repayments, and ensuring the timely collection of dues.

4. Geographical Analysis: The address, city, state, zip_code, and country fields provide valuable geographical information. This data can be used to understand the bank''s customer distribution, tailor services to specific regions, and identify potential areas for expansion or focused marketing efforts.

5. Loyalty Program Management: The loyalty_classification field allows the bank to implement targeted marketing campaigns and offer appropriate benefits to customers based on their tier (e.g., Gold, Platinum, Jade). This can help in improving customer retention and increasing customer lifetime value.

6. Risk Assessment: By combining loan details with customer information, the bank can perform more accurate credit risk assessments. Factors such as loan amount, interest rate, term, and customer''s payment history can be analyzed together to make informed lending decisions and adjust risk strategies.

7. Regulatory Compliance: The comprehensive nature of this view ensures that customer and loan information is properly maintained. This is crucial for meeting regulatory requirements, facilitating audits, and generating necessary reports for compliance purposes.

The customer_payments view provides a holistic view of the bank''s customers, their loans, and payment behaviors. This integrated dataset enables the bank to make data-driven decisions, improve operational efficiency, enhance customer satisfaction, and maintain regulatory compliance. By leveraging this information effectively, the bank can optimize its services, mitigate risks, and drive growth in a competitive financial landscape.' 
    TAGS (mcp) (
    country TAGS (country_classification_tag)
 )
 AS SELECT bank_customers.customer_id AS customer_id, bank_customers.first_name AS first_name, bank_customers.last_name AS last_name, bank_customers.email AS email, bank_customers.phone_number AS phone_number, bank_customers.address AS address, bank_customers.city AS city, bank_customers.state AS state, bank_customers.zip_code AS zip_code, bank_loans.loan_amount AS loan_amount, bank_loans.interest_rate AS interest_rate, bank_loans.term AS term, bank_loans.property_id AS property_id, bank_loans.loan_officer_id AS loan_officer_id, bank_loans.status AS status, bank_loans.date_created AS date_created, bank_payments.payment_id AS payment_id, bank_payments.payment_amount AS payment_amount, bank_payments.payment_date AS payment_date, bank_customers.loyalty_classification AS loyalty_classification, bank_customers.country AS country FROM (customers AS bank_customers INNER JOIN loans AS bank_loans ON bank_customers.customer_id = bank_loans.customer_id ) INNER JOIN loan_payments AS bank_payments ON bank_loans.loan_id = bank_payments.loan_id ;

ALTER VIEW customer_payments
 LAYOUT (customers = [20, 20, 200, 225], loans = [540, 150, 200, 205], loan_payments = [950, 100, 200, 105]);

CHOWN admin VIEW customer_payments LASTMODIFICATIONUSER admin;

CREATE OR REPLACE VIEW iv_bank_properties_loans FOLDER = '/2 - integration views' DESCRIPTION = 'A combination of the bank_properties table and the bank_loans table, where all records from the bank_properties table are retained. This view provides convenient access to see the loans associated with each property.
'  AS SELECT bank_properties.property_id AS property_id, bank_properties.address AS address, bank_properties.city AS city, bank_properties.state AS state, bank_properties.zip_code AS zip_code, bank_properties.property_value AS property_value, bank_loans.loan_id AS loan_id, bank_loans.customer_id AS customer_id, bank_loans.loan_amount AS loan_amount, bank_loans.interest_rate AS interest_rate, bank_loans.term AS term, bank_loans.loan_officer_id AS loan_officer_id, bank_loans.status AS status, bank_loans.date_created AS date_created FROM properties AS bank_properties LEFT OUTER JOIN loans AS bank_loans ON bank_properties.property_id = bank_loans.property_id  ORDER BY property_id ASC;

ALTER VIEW iv_bank_properties_loans
 LAYOUT (properties = [136, 48, 200, 200], loans = [560, 192, 200, 200]);

CHOWN admin VIEW iv_bank_properties_loans LASTMODIFICATIONUSER admin;

CREATE OR REPLACE VIEW iv_bank_west_properties FOLDER = '/2 - integration views' DESCRIPTION = 'A view created from the bank_properties table, including only the records where the properties are located in West Coast states. This view provides convenient access to properties specifically in California, Oregon, and Washington.
'  AS SELECT properties.property_id AS property_id, properties.address AS address, properties.city AS city, properties.state AS state, properties.zip_code AS zip_code, properties.property_value AS property_value FROM properties WHERE state in ('CA', 'OR', 'WA');

CHOWN admin VIEW iv_bank_west_properties LASTMODIFICATIONUSER admin;

CREATE OR REPLACE VIEW iv_banks_properties_per_state FOLDER = '/2 - integration views' DESCRIPTION = 'A view created from the bank_properties table that counts the number of properties in each state. This view provides a summary of property distribution across different states, allowing for quick insights into the concentration of properties in each region.'  (
    count (description = 'The number of properties per state')
 )
 AS SELECT state AS state, count(*) AS count FROM properties GROUP BY state ORDER BY count DESC;

CHOWN admin VIEW iv_banks_properties_per_state LASTMODIFICATIONUSER admin;

