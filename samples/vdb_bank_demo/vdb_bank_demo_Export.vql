CREATE OR REPLACE TABLE bv_loan_policy_knowledge I18N gb (
        chunk_id:text (notnull, sourcetypeid = '-9', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '2147483647', description = 'Identifies an individual text chunk extracted from a loan policy document, enabling each passage to be referenced distinctly within the knowledge view.'),
        document_id:text (notnull, sourcetypeid = '-9', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '2147483647', description = 'Identifies the source loan policy document that a chunk belongs to, supporting document-level grouping and traceability. Example: NCB-LEND-POL-001.'),
        document_name:text (notnull, sourcetypeid = '-9', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '2147483647', description = 'Contains the file or business name of the source document from which the chunk was extracted. It includes values like "sample_loan_policy_e...".'),
        document_type:text (sourcetypeid = '-9', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '2147483647', description = 'Classifies the source document by its business content type, helping distinguish loan policy material from other document categories. Example: loan_policy.'),
        document_version:text (notnull, sourcetypeid = '-9', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '2147483647', description = 'Indicates the version of the source document associated with the extracted chunk, supporting policy version tracking. Example: 1.0.'),
        effective_date:localdate (sourcetypeid = '91', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '13', description = 'Specifies the date from which the source loan policy document or its content is considered effective.'),
        page_number:int (notnull, sourcetypeid = '4', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '10', description = 'Indicates the page in the source document where the chunked content appears, supporting navigation back to the original policy material.'),
        chunk_text:text (notnull, sourcetypeid = '-9', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '2147483647', description = 'Contains the extracted text passage from the loan policy document that is represented as a searchable knowledge chunk.'),
        content_hash:text (notnull, sourcetypeid = '-9', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '2147483647', description = 'Stores a hash value representing the chunk content, supporting detection of duplicate or changed passages across indexed policy material.'),
        file_hash:text (notnull, sourcetypeid = '-9', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '2147483647', description = 'Stores a hash value representing the source document file, supporting detection of duplicate or changed document files.'),
        access_classification:text (sourcetypeid = '-9', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '2147483647', description = 'Indicates the access level or handling classification assigned to the document content. Example: internal-demo.'),
        embedding:vector<float,1536> (notnull, embeddingmodel = 'text-embedding-3-small', sourcetypeid = '10006', sourcetyperadix = '10', description = 'Contains the vector representation of chunk_text generated for semantic matching and retrieval of loan policy knowledge.'),
        indexed_at:timestamptz (notnull, sourcetypeid = '2014', sourcetyperadix = '10', sourcetypedecimals = '6', sourcetypesize = '35', description = 'Records the timestamp when the document chunk was indexed into the knowledge view.')
    )
    FOLDER = '/1 - connectivity/2 - base views'
    DESCRIPTION = 'Contains extracted content from loan policy documents, including eligibility criteria, credit score requirements, affordability limits, loan-to-value ratios, documentation requirements, and approval procedures. Used for semantic search and AI-powered retrieval of relevant loan policy information.'
    CONSTRAINT 'document_chunks_pkey' PRIMARY KEY ( 'chunk_id' )
    CACHE OFF
    TIMETOLIVEINCACHE DEFAULT
    ADD SEARCHMETHOD document_chunks(
        I18N gb
        CONSTRAINTS (
             ADD chunk_id (any) OPT ANY
             ADD document_id (any) OPT ANY
             ADD document_name (any) OPT ANY
             ADD document_type (any) OPT ANY
             ADD document_version (any) OPT ANY
             ADD effective_date (any) OPT ANY
             ADD page_number (any) OPT ANY
             ADD chunk_text (any) OPT ANY
             ADD content_hash (any) OPT ANY
             ADD file_hash (any) OPT ANY
             ADD access_classification (any) OPT ANY
             ADD embedding (any) OPT ANY
             ADD indexed_at (any) OPT ANY
        )
        OUTPUTLIST (access_classification, chunk_id, chunk_text, content_hash, document_id, document_name, document_type, document_version, effective_date, embedding, file_hash, indexed_at, page_number
        )
        WRAPPER (jdbc document_chunks)
    );

CHOWN admin VIEW bv_loan_policy_knowledge LASTMODIFICATIONUSER admin;

