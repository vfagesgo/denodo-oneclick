        email:text (sourcetypeid = '-9', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '256', description = 'The electronic mail address used for communication with the customer. It includes values like "cwoodward@mail.com", "pthomas@webmail.com", "tvaughn@example.com", and "jsutton@sample.com".'),
