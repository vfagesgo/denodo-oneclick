CREATE OR REPLACE TABLE api_gp_details_service I18N us_pst (
        practice_code:text (extern),
        name:text,
        date:gp_details_service_date,
        orgid:gp_details_service_orgid,
        status:text,
        lastchangedate:text,
        orgrecordclass:text,
        geoloc:gp_details_service_geoloc,
        contacts:gp_details_service_contacts,
        roles:gp_details_service_roles,
        rels:gp_details_service_rels
    )
    FOLDER = '/1 - connectivity/2 - base views'
    CACHE PARTIAL
    BATCHSIZEINCACHE DEFAULT
    TIMETOLIVEINCACHE NOEXPIRE
    ONSCHEMACHANGE SYNCHRONIZE INCREMENTAL_LOAD
    CACHE_TABLE_NAME 'c_api_gp_details_service'
    ADD SEARCHMETHOD gp_details_service(
        I18N us_pst
        CONSTRAINTS (
             ADD practice_code (=) OBL ONE
             ADD name NOS ZERO ()
             ADD date NOS ZERO ()
             ADD date NOS ZERO ()
             ADD date.type NOS ZERO ()
             ADD date.start NOS ZERO ()
             ADD orgid NOS ZERO ()
             ADD orgid.root NOS ZERO ()
             ADD orgid.assigningauthorityname NOS ZERO ()
             ADD orgid.extension NOS ZERO ()
             ADD status NOS ZERO ()
             ADD lastchangedate NOS ZERO ()
             ADD orgrecordclass NOS ZERO ()
             ADD geoloc NOS ZERO ()
             ADD geoloc.location NOS ZERO ()
             ADD geoloc.location.addrln1 NOS ZERO ()
             ADD geoloc.location.town NOS ZERO ()
             ADD geoloc.location.county NOS ZERO ()
             ADD geoloc.location.postcode NOS ZERO ()
             ADD geoloc.location.country NOS ZERO ()
             ADD geoloc.location.uprn NOS ZERO ()
             ADD contacts NOS ZERO ()
             ADD contacts.contact NOS ZERO ()
             ADD contacts.contact NOS ZERO ()
             ADD contacts.contact.type NOS ZERO ()
             ADD contacts.contact.value NOS ZERO ()
             ADD roles NOS ZERO ()
             ADD roles.role NOS ZERO ()
             ADD roles.role NOS ZERO ()
             ADD roles.role.id NOS ZERO ()
             ADD roles.role.uniqueroleid NOS ZERO ()
             ADD roles.role.primaryrole NOS ZERO ()
             ADD roles.role.date NOS ZERO ()
             ADD roles.role.date NOS ZERO ()
             ADD roles.role.date.type NOS ZERO ()
             ADD roles.role.date.start NOS ZERO ()
             ADD roles.role.status NOS ZERO ()
             ADD rels NOS ZERO ()
             ADD rels.rel NOS ZERO ()
             ADD rels.rel NOS ZERO ()
             ADD rels.rel.date NOS ZERO ()
             ADD rels.rel.date NOS ZERO ()
             ADD rels.rel.date.type NOS ZERO ()
             ADD rels.rel.date.start NOS ZERO ()
             ADD rels.rel.date.end NOS ZERO ()
             ADD rels.rel.status NOS ZERO ()
             ADD rels.rel.target NOS ZERO ()
             ADD rels.rel.target.orgid NOS ZERO ()
             ADD rels.rel.target.orgid.root NOS ZERO ()
             ADD rels.rel.target.orgid.assigningauthorityname NOS ZERO ()
             ADD rels.rel.target.orgid.extension NOS ZERO ()
             ADD rels.rel.target.primaryroleid NOS ZERO ()
             ADD rels.rel.target.primaryroleid.id NOS ZERO ()
             ADD rels.rel.target.primaryroleid.uniqueroleid NOS ZERO ()
             ADD rels.rel.id NOS ZERO ()
             ADD rels.rel.uniquerelid NOS ZERO ()
        )
        OUTPUTLIST (contacts, date, geoloc, lastchangedate, name, orgid, orgrecordclass, rels, roles, status
        )
        WRAPPER (json gp_details_service)
    )
    DECLARE VIEW CLUSTER INDEX gp_id ON (practice_code)
    DECLARE CACHE INDEX idx_practice_code UNIQUE  ON (practice_code);

CHOWN admin VIEW api_gp_details_service LASTMODIFICATIONUSER admin;

