# #######################################
# METRIC VIEWS
# #######################################
CREATE OR REPLACE METRIC VIEW mv_clinical_trials
    FOLDER = '/3 - data products/metrics views'
    TAGS (ai_ready)
    SOURCES (
        presentation AS presentation,
        clinical_trials AS clinical_trials,
        patients AS patients,
        common_date AS common_date,
        products AS products    
    )
    ASSOCIATIONS (
        clinical_trials patients clinical_trials_pharm_ai_patients,
        clinical_trials products clinical_trials_pharm_ai_products,
        clinical_trials presentation clinical_trials_pharm_ai_presentation,
        clinical_trials common_date clinical_trials_pharm_ai_common_date    
    )
    DIMENSIONS (
        clinical_trials(
            trial_id AS clinical_trials.trial_id,
            end_date_key AS clinical_trials.end_date_key,
            trial_name AS clinical_trials.trial_name,
            start_date_key AS clinical_trials.start_date_key,
            trial_status AS clinical_trials.trial_status
        ),
        patients(
            birth_month AS patients.birth_month,
            last_name AS patients.last_name,
            login AS patients.login,
            last_review_date AS patients.last_review_date,
            birth_country AS patients.birth_country,
            birth_year AS patients.birth_year,
            key_patient_flag AS patients.key_patient_flag,
            birth_day AS patients.birth_day,
            patient_sk AS patients.patient_sk,
            email_address AS patients.email_address,
            patient_id AS patients.patient_id,
            salutation AS patients.salutation,
            first_name AS patients.first_name,
            current_addr_sk AS patients.current_addr_sk
        ),
        products(
            bnf_code AS products.bnf_code
        ),
        presentation(
            bnf_drug_code AS presentation.bnf_drug_code,
            bnf_section_key AS presentation.bnf_section_key,
            bnf_paragraph_key AS presentation.bnf_paragraph_key,
            generic_name AS presentation.generic_name,
            brand_name AS presentation.brand_name,
            bnf_chapter_key AS presentation.bnf_chapter_key
        ),
        common_date(
            month_year_name AS common_date.month_year_name,
            month_name AS common_date.month_name,
            fiscal_year_end_key AS common_date.fiscal_year_end_key,
            actual_date AS common_date.actual_date,
            fiscal_year_name AS common_date.fiscal_year_name,
            fiscal_quarter_name AS common_date.fiscal_quarter_name,
            date_name AS common_date.date_name,
            date_key AS common_date.date_key,
            year_name AS common_date.year_name,
            quarter_name AS common_date.quarter_name
        )    
    )
    METRICS (
        num_trials AS count(clinical_trials.trial_status),
        completion_reliability_rate AS round(((100.0*count(case WHEN (clinical_trials.trial_status = 'Completed') THEN 1 END))/nullif(count(case WHEN (clinical_trials.trial_status not in ('Ongoing', 'Recruting')) THEN 1 END), 0))),
        percentage_of_portfolio AS round(((100*count(clinical_trials.trial_id))/sum(count(clinical_trials.trial_id)) OVER ( )))    
    )
;

