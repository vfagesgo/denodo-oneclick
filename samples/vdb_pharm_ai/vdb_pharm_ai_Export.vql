CREATE OR REPLACE WRAPPER JSON gp_details_service
    FOLDER = '/1 - connectivity/2 - base views'
    DATASOURCENAME=gp_details_service
    TUPLEROOT '/Organisation'
    ROUTE HTTP 'http.ApacheHttpClientConnection,120000' GET '${databases.pharm_ai.folder.1 - connectivity.folder.2 - base views.views.json.gp_details_service.ROUTE.HTTP.URL}'
    OUTPUTSCHEMA (organisation = 'Organisation' : REGISTER OF (
        practice_code = 'PRACTICE_CODE' : 'java.lang.String' (OBL) (DEFAULTVALUE='G82069') EXTERN,
        name = 'Name' : 'java.lang.String',
        date = 'Date' : ARRAY OF (
            date = 'Date' : REGISTER OF (
                type = 'Type' : 'java.lang.String',
                start = 'Start' : 'java.lang.String'
            )
        ),
        orgid = 'OrgId' : REGISTER OF (
            root = 'root' : 'java.lang.String',
            assigningauthorityname = 'assigningAuthorityName' : 'java.lang.String',
            extension = 'extension' : 'java.lang.String'
        ),
        status = 'Status' : 'java.lang.String',
        lastchangedate = 'LastChangeDate' : 'java.lang.String',
        orgrecordclass = 'orgRecordClass' : 'java.lang.String',
        geoloc = 'GeoLoc' : REGISTER OF (
            location = 'Location' : REGISTER OF (
                addrln1 = 'AddrLn1' : 'java.lang.String',
                town = 'Town' : 'java.lang.String',
                county = 'County' : 'java.lang.String',
                postcode = 'PostCode' : 'java.lang.String',
                country = 'Country' : 'java.lang.String',
                uprn = 'UPRN' : 'java.lang.Integer'
            )
        ),
        contacts = 'Contacts' : REGISTER OF (
            contact = 'Contact' : ARRAY OF (
                contact = 'Contact' : REGISTER OF (
                    type = 'type' : 'java.lang.String',
                    value = 'value' : 'java.lang.String'
                )
            )
        ),
        roles = 'Roles' : REGISTER OF (
            role = 'Role' : ARRAY OF (
                role = 'Role' : REGISTER OF (
                    id = 'id' : 'java.lang.String',
                    uniqueroleid = 'uniqueRoleId' : 'java.lang.Integer',
                    primaryrole = 'primaryRole' : 'java.lang.String',
                    date = 'Date' : ARRAY OF (
                        date = 'Date' : REGISTER OF (
                            type = 'Type' : 'java.lang.String',
                            start = 'Start' : 'java.lang.String'
                        )
                    ),
                    status = 'Status' : 'java.lang.String'
                )
            )
        ),
        rels = 'Rels' : REGISTER OF (
            rel = 'Rel' : ARRAY OF (
                rel = 'Rel' : REGISTER OF (
                    date = 'Date' : ARRAY OF (
                        date = 'Date' : REGISTER OF (
                            type = 'Type' : 'java.lang.String',
                            start = 'Start' : 'java.lang.String',
                            end = 'End' : 'java.lang.String'
                        )
                    ),
                    status = 'Status' : 'java.lang.String',
                    target = 'Target' : REGISTER OF (
                        orgid = 'OrgId' : REGISTER OF (
                            root = 'root' : 'java.lang.String',
                            assigningauthorityname = 'assigningAuthorityName' : 'java.lang.String',
                            extension = 'extension' : 'java.lang.String'
                        ),
                        primaryroleid = 'PrimaryRoleId' : REGISTER OF (
                            id = 'id' : 'java.lang.String',
                            uniqueroleid = 'uniqueRoleId' : 'java.lang.Integer'
                        )
                    ),
                    id = 'id' : 'java.lang.String',
                    uniquerelid = 'uniqueRelId' : 'java.lang.Integer'
                )
            )
        )
    )
    );

CHOWN admin WRAPPER JSON gp_details_service LASTMODIFICATIONUSER admin;

