CREATE OR REPLACE VIEW iv_dm_query_impl FOLDER = '/03 - derived views' AS SELECT iv_dm_query_api.updated_at AS updated_at, iv_dm_query_api.id AS id, iv_dm_query_api.created_at AS created_at, iv_dm_query_api.name AS name, iv_dm_query_api.description AS description, iv_dm_query_api.external_element_type AS external_element_type, iv_dm_query_api.url AS url, case WHEN ((iv_dm_query_api.associations).associated_element_id is null ) THEN cast('external_element_association_array_type', NULL) ELSE iv_dm_query_api.associations END AS associations FROM iv_dm_query_api;

CHOWN admin VIEW iv_dm_query_impl LASTMODIFICATIONUSER admin;

