        city:text (sourcetypeid = '-9', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '256', description = 'The urban area where the customer is located. It includes values like "Barcelona" and "Madrid".'),
        state:text (sourcetypeid = '-9', sourcetyperadix = '10', sourcetypedecimals = '0', sourcetypesize = '256', description = 'The regional administrative division where the customer resides. No sample data is available for this field.'),
