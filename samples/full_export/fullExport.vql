CREATE OR REPLACE FOLDER '/1 - Connectivity' DESCRIPTION 'Connectivity Layer: Anything related to the physical systems. This includes data sources and base views built on top of these data sources.' ;

CHOWN admin FOLDER '/1 - Connectivity';

CREATE OR REPLACE FOLDER '/1 - connectivity/1 - Data Sources' ;

CHOWN admin FOLDER '/1 - connectivity/1 - Data Sources';

CREATE OR REPLACE FOLDER '/1 - connectivity/2 - Base Views' ;

CHOWN admin FOLDER '/1 - connectivity/2 - Base Views';

CREATE OR REPLACE FOLDER '/2 - Integration Views' DESCRIPTION 'Integration Layer: This layer Includes the combinations of base views, called derived views. Those views are usually not directly consumed by end users but used by development teams to create business entities and reporting views.' ;

CHOWN admin FOLDER '/2 - Integration Views';

CREATE OR REPLACE FOLDER '/3 - Data Products' DESCRIPTION 'Business Entities: This layer includes canonical business entities usually represented as interfaces. They can either be used as reporting or for further report development.' ;

CHOWN admin FOLDER '/3 - Data Products';

CREATE OR REPLACE FOLDER '/3 - data products/Metric Views' ;

CHOWN admin FOLDER '/3 - data products/Metric Views';

CREATE OR REPLACE FOLDER '/4 - Report Views' DESCRIPTION 'Report Views: This layer contains pre-built reports and analysis frequently consumed by users. These elements are built on top of the integration layer and/or the business entities layer.' ;

CHOWN admin FOLDER '/4 - Report Views';

CREATE OR REPLACE FOLDER '/5 - Data Services' ;

CHOWN admin FOLDER '/5 - Data Services';

CREATE OR REPLACE FOLDER '/6 - Associations' DESCRIPTION 'Associations: Define all referential constraints as Associations, especially when these traverse different data sources.' ;

CHOWN admin FOLDER '/6 - Associations';

