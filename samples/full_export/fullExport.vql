CREATE OR REPLACE VIEW iv_dm_query_api_aux FOLDER = '/03 - derived views' AS
    SELECT cast(bv_dm_public_query.id AS TEXT) AS id,
           bv_dm_public_query.name AS name,
           (
               (
                   (
                       bv_dm_public_query.description || '. SharedQuery: '
                   ) || ' TYPE: '
               ) || bv_dm_public_query.type
           ) AS description,
           'PUBLIC_QUERY' AS external_element_type,
           (
               'http://localhost:9090/denodo-data-catalog/?auth=login#/public-query/' || cast(
                   bv_dm_public_query.id AS TEXT
               )
           ) AS url,
           cast('timestamp', now()) AS created_at,
           cast('timestamp', now()) AS updated_at,
           ((bv_dm_public_query.database_0 || '.') || bv_dm_public_query.view_0) AS associated_element_id,
           NULL AS external_tool_server_name,
           'VIEW' AS associated_element_type,
           'OUT' AS direction,
           'Use' AS role
    FROM bv_dm_public_query CONTEXT ('formatted' = 'yes');

CHOWN admin VIEW iv_dm_query_api_aux LASTMODIFICATIONUSER admin;

CREATE OR REPLACE VIEW iv_scheduler_metadata_api_aux FOLDER = '/03 - derived views' AS SELECT cast(bv_scheduler_api.id AS TEXT) AS id, bv_scheduler_api.name AS name, ((bv_scheduler_api.description||'. Project: ')||bv_scheduler_api."projectName") AS description, 'ETL' AS external_element_type, concat('http://kubernetes.docker.internal:9090/webadmin/denodo-scheduler-admin/?uri=//localhost:8000#/jobs/', cast(bv_scheduler_api."projectId" AS TEXT), '/', cast(bv_scheduler_api.id AS TEXT)) AS url, cast('timestamp', now()) AS created_at, cast('timestamp', now()) AS updated_at, bv_scheduler_api."viewName" AS associated_element_id, NULL AS external_tool_server_name, 'VIEW' AS associated_element_type, 'OUT' AS direction, bv_scheduler_api.type AS role FROM bv_scheduler_api;

CHOWN admin VIEW iv_scheduler_metadata_api_aux LASTMODIFICATIONUSER admin;

ALTER VIEW iv_scheduler_metadata_api_aux
 LAYOUT (bv_scheduler_api = [0, 0, 200, 200]);

CREATE OR REPLACE VIEW dv_data_product_metadata_impl FOLDER = '/03 - derived views' AS SELECT bv_data_product.id AS id, bv_data_product.name AS name, bv_data_product.description AS description, bv_data_product.external_element_type AS external_element_type, bv_data_product.url AS url, cast('timestamp', now()) AS created_at, cast('timestamp', now()) AS updated_at, dv_nested_data_product_associations.associations AS associations FROM bv_data_product AS bv_data_product LEFT OUTER JOIN dv_nested_data_product_associations AS dv_nested_data_product_associations ON bv_data_product.id = dv_nested_data_product_associations.owner_external_element_id ;

