CREATE OR REPLACE VIEW dv_agent_skill_files FOLDER = '/03 - derived views' AS SELECT bv_agent_skill.parentfolder AS parentfolder, bv_agent_skill."relativePath" AS "relativePath", bv_agent_skill.filename AS filename, bv_agent_skill.extension AS extension, bv_agent_skill.fullpath AS fullpath, bv_agent_skill.filetype AS filetype, bv_agent_skill.hidden AS hidden, bv_agent_skill.datemodified AS datemodified, bv_agent_skill.canread AS canread, bv_agent_skill.canwrite AS canwrite, bv_agent_skill.canexecute AS canexecute, bv_agent_skill.size AS size, bv_agent_skill.recursive AS recursive, bv_agent_skill.binarycontents AS binarycontents, bv_agent_skill.textcontents AS textcontents, bv_agent_skill.readencoding AS readencoding, bv_agent_skill.append AS append, bv_agent_skill.overwrite AS overwrite, hash(fullpath) AS external_element_id, regexp("relativePath", '^[\\/]?([^\\/]+).*', '$$1') AS skill_name, case WHEN ((filename = 'SKILL.md' AND regexp("relativePath", '^[\\/]?([^\\/]+)[\\/]?$', '$1') is not null )) THEN true ELSE false END AS is_main_file FROM bv_agent_skill WHERE (filetype = 'file' AND recursive = true AND parentfolder = '../samples/skills' AND readencoding = 'UTF-8');

CHOWN admin VIEW dv_agent_skill_files LASTMODIFICATIONUSER admin;

ALTER VIEW dv_agent_skill_files
 LAYOUT (bv_agent_skill = [0, 0, 200, 200]);

