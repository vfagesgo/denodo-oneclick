    USERPASSWORD = '${databases.bank_demo.folder.1 - connectivity.folder.1 - data sources.datasources.jdbc.bank.USERPASSWORD}' ${databases.bank_demo.folder.1 - connectivity.folder.1 - data sources.datasources.jdbc.bank.USERPASSWORD.ENCRYPTED}
    CLASSPATH = 'postgresql'
    DATABASENAME = 'postgresql'
    DATABASEVERSION = '17'
    FETCHSIZE = 1000
    VALIDATIONQUERY = 'Select 1'
    INITIALSIZE = 4
    MAXIDLE = -1
    MINIDLE = 0
    MAXACTIVE = 20
    EXHAUSTEDACTION = 1
    TESTONBORROW = true
    TESTONRETURN = false
    TESTWHILEIDLE = false
    TIMEBETWEENEVICTION = -1
    NUMTESTPEREVICTION = 3
    MINEVICTABLETIME = 1800000
    POOLPREPAREDSTATEMENTS = false
    MAXOPENPREPAREDSTATEMENTS = -1
    PROPERTIES ('reWriteBatchedInserts'='true', 'escapeSyntaxCallMode'='callIfNoReturn', 'ApplicationName'='Denodo')
    KERBEROSPROPERTIES ('jaasLogin'='false', 'user'='<user>')
    DATA_LOAD_CONFIGURATION (
        BATCHINSERTSIZE = 200
    )
    PROCESSING_UNITS = 1
    CPUS_PER_PROCESSING_UNIT = 1;

