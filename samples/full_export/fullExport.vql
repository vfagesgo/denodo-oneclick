             ADD patient_id (any) OPT ANY
             ADD current_addr_sk (any) OPT ANY
             ADD salutation (any) OPT ANY
             ADD first_name (any) OPT ANY
             ADD last_name (any) OPT ANY
             ADD key_patient_flag (any) OPT ANY
             ADD birth_day (any) OPT ANY
             ADD birth_month (any) OPT ANY
             ADD birth_year (any) OPT ANY
             ADD birth_country (any) OPT ANY
             ADD login (any) OPT ANY
             ADD email_address (any) OPT ANY
             ADD last_review_date (any) OPT ANY
        )
        OUTPUTLIST (birth_country, birth_day, birth_month, birth_year, current_addr_sk, email_address, first_name, key_patient_flag, last_name, last_review_date, login, patient_id, patient_sk, salutation
        )
        WRAPPER (jdbc ct_patients)
    )
    SMART_THEN_ATSOURCE_THROUGH_VDP;

