    )
    CONSTRAINT 'Acct_pkey' PRIMARY KEY ( 'acct_id' )
    CONSTRAINT 'Acct_customer_id_fkey' FOREIGN KEY ( 'customer_id' ) 
    REFERENCES '${databases.bank_demo.folder.1 - connectivity.folder.2 - base views.views.jdbc.bv_bank_acct.SCHEMANAME.ACCT_CUSTOMER_ID_FKEY}'.'Customers'( 'customer_id' )  ON UPDATE NO ACTION  ON DELETE NO ACTION NOT DEFERRABLE 
