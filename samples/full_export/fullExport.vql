CREATE OR REPLACE DATASOURCE JSON ds_data_marketplace
    FOLDER = '/01 - data sources'
    OPENAPI3 (
        DOCUMENT_ACCESS_CONFIGURATION (
            HTTP 'http.ApacheHttpClientConnection,120000' GET '${databases.asset_extensions.folder.01 - data sources.datasources.json.ds_data_marketplace.DOCUMENT_ACCESS_CONFIGURATION.HTTP.URL}'
                CHECKCERTIFICATES
             AUTHENTICATION OFF
        )
        DEFAULT_CONFIGURATION_FOR_BASE_VIEWS (
            ROUTE HTTP 'http.ApacheHttpClientConnection,120000' GET '${databases.asset_extensions.folder.01 - data sources.datasources.json.ds_data_marketplace.DEFAULT_CONFIGURATION_FOR_BASE_VIEWS.HTTP.URL}'
             AUTHENTICATION BASIC ( 
                  USER '${databases.asset_extensions.folder.01 - data sources.datasources.json.ds_data_marketplace.DEFAULT_CONFIGURATION_FOR_BASE_VIEWS.HTTP.USER}'
                  PASSWORD '${databases.asset_extensions.folder.01 - data sources.datasources.json.ds_data_marketplace.DEFAULT_CONFIGURATION_FOR_BASE_VIEWS.HTTP.PASSWORD}' ${databases.asset_extensions.folder.01 - data sources.datasources.json.ds_data_marketplace.DEFAULT_CONFIGURATION_FOR_BASE_VIEWS.HTTP.PASSWORD.ENCRYPTED} )
                PROXY OFF
        )
    );

CHOWN admin DATASOURCE JSON ds_data_marketplace LASTMODIFICATIONUSER admin;

