# #######################################
# VIEWS of aws_tpcds
# #######################################
# #######################################
# ASSOCIATIONS of aws_tpcds
# #######################################
CREATE OR REPLACE ASSOCIATION customer_demographics_customer REFERENTIAL CONSTRAINT 
FOLDER = '/6-associations'
    ENDPOINT customer customer_demographics PRINCIPAL (0,1)
    ENDPOINT customer_demographics customer (0,*)
    ADD MAPPING cd_demo_sk=c_current_cdemo_sk;

CHOWN admin ASSOCIATION customer_demographics_customer LASTMODIFICATIONUSER admin;

CREATE OR REPLACE ASSOCIATION "customer_web_sales_WS_BILL_CUSTOMER_SK" REFERENTIAL CONSTRAINT 
FOLDER = '/6-associations'
    ENDPOINT "web_sales_WS_BILL_CUSTOMER_SK" customer PRINCIPAL (0,1)
    ENDPOINT "customer_WS_BILL_CUSTOMER_SK" web_sales (0,*)
    ADD MAPPING c_customer_sk=ws_bill_customer_sk;

CHOWN admin ASSOCIATION "customer_web_sales_WS_BILL_CUSTOMER_SK" LASTMODIFICATIONUSER admin;

CREATE OR REPLACE ASSOCIATION "date_dim_web_sales_WS_SOLD_DATE_SK" REFERENTIAL CONSTRAINT 
FOLDER = '/6-associations'
    ENDPOINT "web_sales_WS_SOLD_DATE_SK" date_dim PRINCIPAL (0,1)
    ENDPOINT "date_dim_WS_SOLD_DATE_SK" web_sales (0,*)
    ADD MAPPING d_date_sk=ws_sold_date_sk;

CHOWN admin ASSOCIATION "date_dim_web_sales_WS_SOLD_DATE_SK" LASTMODIFICATIONUSER admin;

CREATE OR REPLACE ASSOCIATION promotion_web_sales REFERENTIAL CONSTRAINT 
FOLDER = '/6-associations'
    ENDPOINT web_sales promotion PRINCIPAL (0,1)
    ENDPOINT promotion web_sales (0,*)
    ADD MAPPING p_promo_sk=ws_promo_sk;

CHOWN admin ASSOCIATION promotion_web_sales LASTMODIFICATIONUSER admin;

CREATE OR REPLACE ASSOCIATION warehouse_web_sales REFERENTIAL CONSTRAINT 
FOLDER = '/6-associations'
    ENDPOINT web_sales warehouse PRINCIPAL (0,1)
    ENDPOINT warehouse web_sales (0,*)
    ADD MAPPING w_warehouse_sk=ws_warehouse_sk;

CHOWN admin ASSOCIATION warehouse_web_sales LASTMODIFICATIONUSER admin;

# #######################################
# METRIC VIEWS of aws_tpcds
# #######################################
CREATE OR REPLACE METRIC VIEW mv_web_sales_customer_kpis
    FOLDER = '/5-business/metric views'
    DESCRIPTION = 'mv_web_sales_customer_kpis is a customer-centric metric view that consolidates web sales with customer and supporting dimension data to deliver standardized, analytics-ready KPIs at the customer level.
 
Key characteristics:

- Aggregated customer KPIs: calculates total revenue, average order value, average items per order, and profit margin for each customer.

- Contextual dimensions retained: includes date, product, promotion, customer demographics and warehouse context to allow slicing and filtering of the KPIs.

- Designed for reuse: built to support consistent reporting, analysis, and downstream data products or models.
 
Primary uses:

- Reporting & dashboards: monitor customer revenue and ordering behavior, and surface trends and exceptions.

- Customer segmentation & lifecycle analysis: identify high-value customers, segment by purchase behavior, and analyze cohorts over time.

- Marketing measurement: assess promotion and channel performance at the customer level to inform targeting and ROI calculations.

- Profitability analysis: analyze margin contribution per customer and support margin-driven merchandising or pricing decisions.

- ML feature engineering: provide aggregated features for models such as customer lifetime value (LTV), churn prediction, and personalization.

- Flexible ad-hoc analysis: perform date-, product-, promotion-, or demographic-based breakdowns to investigate business questions.
 
Overall, mv_web_sales_customer_kpis is intended as a single, reliable source of customer-level web sales metrics that supports reporting, analytics, and modeling workflows while preserving the dimensional context needed for detailed analysis.' 
     (
    total_revenue (description = 'Total net paid by customer'),
    average_order_value (description = 'Average revenue per order for the customer'),
    average_items_per_order (description = 'Average number of items per order for the customer'),
    profit_margin_pct (description = 'Profit margin percentage = 100 * total profit / total revenue')
 )
SOURCES (
        customer_demographics AS customer_demographics,
        web_sales AS web_sales,
        date_dim AS date_dim,
        warehouse AS warehouse,
        customer AS customer,
        promotion AS promotion    
    )
    ASSOCIATIONS (
        customer web_sales "customer_web_sales_WS_BILL_CUSTOMER_SK",
        date_dim web_sales "date_dim_web_sales_WS_SOLD_DATE_SK",
        promotion web_sales promotion_web_sales,
        warehouse web_sales warehouse_web_sales,
        customer_demographics customer customer_demographics_customer    
    )
    DIMENSIONS (
        customer(
            c_customer_sk AS customer.c_customer_sk,
            c_customer_id AS customer.c_customer_id,
            c_first_name AS customer.c_first_name,
            c_last_name AS customer.c_last_name,
            c_email_address AS customer.c_email_address,
            c_preferred_cust_flag AS customer.c_preferred_cust_flag,
            c_birth_year AS customer.c_birth_year,
            c_birth_country AS customer.c_birth_country
        ),
        sales_date(
            ws_sold_date_sk AS web_sales.ws_sold_date_sk
        ),
        date_dim(
            d_date_sk AS date_dim.d_date_sk,
            d_date_id AS date_dim.d_date_id,
            d_date AS date_dim.d_date,
            d_month_seq AS date_dim.d_month_seq,
            d_week_seq AS date_dim.d_week_seq,
            d_quarter_seq AS date_dim.d_quarter_seq,
            d_year AS date_dim.d_year,
            d_dow AS date_dim.d_dow,
            d_moy AS date_dim.d_moy,
            d_dom AS date_dim.d_dom,
            d_qoy AS date_dim.d_qoy,
            d_fy_year AS date_dim.d_fy_year,
            d_fy_quarter_seq AS date_dim.d_fy_quarter_seq,
            d_fy_week_seq AS date_dim.d_fy_week_seq,
            d_day_name AS date_dim.d_day_name,
            d_quarter_name AS date_dim.d_quarter_name,
            d_holiday AS date_dim.d_holiday,
            d_weekend AS date_dim.d_weekend,
            d_following_holiday AS date_dim.d_following_holiday,
            d_first_dom AS date_dim.d_first_dom,
            d_last_dom AS date_dim.d_last_dom,
            d_same_day_ly AS date_dim.d_same_day_ly,
            d_same_day_lq AS date_dim.d_same_day_lq,
            d_current_day AS date_dim.d_current_day,
            d_current_week AS date_dim.d_current_week,
            d_current_month AS date_dim.d_current_month,
            d_current_quarter AS date_dim.d_current_quarter,
            d_current_year AS date_dim.d_current_year
        ),
        promotion(
            p_promo_sk AS promotion.p_promo_sk,
            p_promo_id AS promotion.p_promo_id,
            p_start_date_sk AS promotion.p_start_date_sk,
            p_end_date_sk AS promotion.p_end_date_sk,
            p_item_sk AS promotion.p_item_sk,
            p_response_target AS promotion.p_response_target,
            p_promo_name AS promotion.p_promo_name,
            p_channel_dmail AS promotion.p_channel_dmail,
            p_channel_email AS promotion.p_channel_email,
            p_channel_catalog AS promotion.p_channel_catalog,
            p_channel_tv AS promotion.p_channel_tv,
            p_channel_radio AS promotion.p_channel_radio,
            p_channel_press AS promotion.p_channel_press,
            p_channel_event AS promotion.p_channel_event,
            p_channel_demo AS promotion.p_channel_demo,
            p_channel_details AS promotion.p_channel_details,
            p_purpose AS promotion.p_purpose,
            p_discount_active AS promotion.p_discount_active
        ),
        warehouse(
            w_warehouse_sk AS warehouse.w_warehouse_sk,
            w_warehouse_id AS warehouse.w_warehouse_id,
            w_warehouse_name AS warehouse.w_warehouse_name,
            w_warehouse_sq_ft AS warehouse.w_warehouse_sq_ft,
            w_street_number AS warehouse.w_street_number,
            w_street_name AS warehouse.w_street_name,
            w_street_type AS warehouse.w_street_type,
            w_suite_number AS warehouse.w_suite_number,
            w_city AS warehouse.w_city,
            w_county AS warehouse.w_county,
            w_state AS warehouse.w_state,
            w_zip AS warehouse.w_zip,
            w_country AS warehouse.w_country
        ),
        customer_demographics(
            cd_demo_sk AS customer_demographics.cd_demo_sk,
            cd_gender AS customer_demographics.cd_gender,
            cd_marital_status AS customer_demographics.cd_marital_status,
            cd_education_status AS customer_demographics.cd_education_status,
            cd_purchase_estimate AS customer_demographics.cd_purchase_estimate,
            cd_credit_rating AS customer_demographics.cd_credit_rating,
            cd_dep_count AS customer_demographics.cd_dep_count,
            cd_dep_employed_count AS customer_demographics.cd_dep_employed_count,
            cd_dep_college_count AS customer_demographics.cd_dep_college_count
        )    
    )
    METRICS (
        total_revenue AS sum(web_sales.ws_net_paid),
        average_order_value AS round((sum(web_sales.ws_net_paid)/nullif(count(DISTINCT web_sales.ws_order_number), 0)), 2),
        average_items_per_order AS round((sum(web_sales.ws_quantity)/nullif(count(DISTINCT web_sales.ws_order_number), 0)), 2),
        profit_margin_pct AS round(((100.0*sum(web_sales.ws_net_profit))/nullif(sum(web_sales.ws_net_paid), 0)), 2)    
    )
;

