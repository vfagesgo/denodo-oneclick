CREATE OR REPLACE DATASOURCE JDBC postgres_tpch
    DRIVERCLASSNAME = 'org.postgresql.Driver'
    DATABASEURI = '${databases.aws_tpcds.datasources.jdbc.postgres_tpch.DATABASEURI}'
    USERNAME = '${databases.aws_tpcds.datasources.jdbc.postgres_tpch.USERNAME}'
    USERPASSWORD = '${databases.aws_tpcds.datasources.jdbc.postgres_tpch.USERPASSWORD}' ${databases.aws_tpcds.datasources.jdbc.postgres_tpch.USERPASSWORD.ENCRYPTED}
    CLASSPATH = 'postgresql-9'
    DATABASENAME = 'postgresql'
    DATABASEVERSION = '9'
    IGNORETRAILINGSPACES = TRUE
    FETCHSIZE = 50000
    VALIDATIONQUERY = 'Select 1'
    INITIALSIZE = 4
    MAXIDLE = -1
    MINIDLE = 0
    MAXACTIVE = 20
    EXHAUSTEDACTION = 1
    TESTONBORROW = true
    TESTONRETURN = false
    TESTWHILEIDLE = false
    TIMEBETWEENEVICTION = -1
    NUMTESTPEREVICTION = 3
    MINEVICTABLETIME = 1800000
    POOLPREPAREDSTATEMENTS = false
    MAXOPENPREPAREDSTATEMENTS = -1
    DATA_LOAD_CONFIGURATION (
        USE_FOR_QUERY_OPTIMIZATION = DATA_MOVEMENT
        BATCHINSERTSIZE = 200
    )
    DESCRIPTION  = 'vps610547.ovh.net'
    SOURCECONFIGURATION (
        delegatefetchinsubqueries = false,
        delegateoffsetinsubqueries = false,
        delegatealloperators = true,
        delegatearrayliteral = true,
        supportsgroupbyliteralasparameter = true,
        delegateinvalidnumberliteralsasnull = true,
        delegateorderby = false,
        delegateregisterliteral = true,
        delegateminus = true,
        delegateintersection = true,
        supportseqouterjoinoperator = true,
        blocksize = 32,
        multiblockreadcount = 16,
        delegateaggregatefunctionslist = (avg, count, max, min, stdev, stdevp, sum, var, varp),
        delegatescalarfunctionslist = (abs, acos, addday, ascii, asin, atan, atan2, case, cast, ceil, char, coalesce, concat, cos, cot, current_date, degrees, div, exp, floor, formatdate, getday, getdayofweek, getdayofyear, getdaysbetween, gethour, getmillisecond, getminute, getmonth, getquarter, getsecond, getweek, getyear, instr, len, ln, log, lower, ltrim, max, min, mod, mult, now, nullif, pi, position, pow, power, radians, rand, regexp, removeaccents, repeat, replace, round, rtrim, sign, sin, sql_trim, sqrt, substr, substring, subtract, sum, tan, textcat, to_date, to_interval_day_second(evaluate_literal), to_interval_year_month(evaluate_literal), to_localdate, to_time, to_timestamp, to_timestamptz, trim, upper)
    );

CHOWN admin DATASOURCE JDBC postgres_tpch LASTMODIFICATIONUSER admin;

