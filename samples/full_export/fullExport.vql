             ADD "reportSection" NOS ZERO ()
             ADD "reportSection"."reportConfig" NOS ZERO ()
             ADD "reportSection"."reportConfig"."maxIndividualReports" NOS ZERO ()
             ADD "reportSection"."reportConfig"."reportOnlyErrors" NOS ZERO ()
             ADD type_0 NOS ZERO ()
             ADD type NOS ZERO ()
