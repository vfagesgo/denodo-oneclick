CREATE OR REPLACE VIEW dv_skill_associations FOLDER = '/03 - derived views' AS
SELECT parent_id AS parent_external_element_id,
           nest(
               associated_element_id,
               external_tool_server_name,
               associated_element_type,
               direction,
               role
           ) AS associations
    FROM (
             SELECT parent.parent_id AS parent_id,
                    child.external_element_id AS associated_element_id,
                    'Agent Skill Server' AS external_tool_server_name,
                    'EXTERNAL_ELEMENT' AS associated_element_type,
                    'OUT' AS direction,
                    'references' AS role
             FROM dv_agent_skill_files AS child
                  INNER JOIN (
                      SELECT external_element_id AS parent_id,
                             skill_name
                      FROM dv_agent_skill_files
                      WHERE is_main_file IS TRUE
                  ) AS parent
                      ON child.skill_name = parent.skill_name
             WHERE child.is_main_file IS FALSE
            UNION ALL
    SELECT
        "a"."owner_external_element_id" AS "parent_external_element_id",
        "a"."associated_element_id" AS "associated_element_id",
         "a"."external_tool_server_name"AS external_tool_server_name,
        #'Agent Skill Server'
        "a"."associated_element_type" AS "associated_element_type",
        "a"."direction",
        "a"."role"
    FROM "asset_extensions"."bv_skills_associated_assets" "a"
         )
    GROUP BY parent_id CONTEXT ('formatted' = 'yes');

CHOWN admin VIEW dv_skill_associations LASTMODIFICATIONUSER admin;

CREATE OR REPLACE VIEW iv_dm_query_api FOLDER = '/03 - derived views' AS SELECT updated_at AS updated_at, id AS id, created_at AS created_at, name AS name, description AS description, external_element_type AS external_element_type, url AS url, cast('external_element_association_array_type', nest(associated_element_id, external_tool_server_name, associated_element_type, direction, role)) AS associations FROM iv_dm_query_api_aux GROUP BY updated_at, id, created_at, name, description, external_element_type, url;

CHOWN admin VIEW iv_dm_query_api LASTMODIFICATIONUSER admin;

CREATE OR REPLACE VIEW iv_scheduler_metadata_api FOLDER = '/03 - derived views' AS SELECT updated_at AS updated_at, id AS id, created_at AS created_at, name AS name, description AS description, external_element_type AS external_element_type, url AS url, cast('external_element_association_array_type', nest(associated_element_id, external_tool_server_name, associated_element_type, direction, role)) AS associations FROM iv_scheduler_metadata_api_aux GROUP BY updated_at, id, created_at, name, description, external_element_type, url;

CHOWN admin VIEW iv_scheduler_metadata_api LASTMODIFICATIONUSER admin;

CREATE OR REPLACE VIEW dv_skill_metadata_impl FOLDER = '/03 - derived views' AS SELECT external_element_id AS id, case WHEN (is_main_file is true ) THEN regexp(textcontents, '(?s).*?name:\s*([^\r\n]+).*', '$$1') ELSE ((replace(substr("relativePath", 2), '\', '/')||'/')||filename) END AS name, case WHEN (is_main_file is true ) THEN regexp(textcontents, '(?s)^.*?description:\s*(?:\|-|\|-?|\|>)?\s*\n?((?:[\s&&[^\r\n]]+[^\r\n]+(?:\r?\n)?)+).*$$', '$$1') ELSE '' END AS description, case WHEN (is_main_file is true ) THEN 'AGENT_SKILL' ELSE 'AGENT_SKILL_RESOURCE' END AS external_element_type, NULL AS url, case WHEN (is_main_file is true ) THEN '' ELSE case WHEN (substr("relativePath", (len(skill_name)+3)) = '') THEN filename ELSE ((replace(substr("relativePath", (len(skill_name)+3)), '\', '/')||'/')||filename) END END AS relative_path, datemodified AS created_at, datemodified AS updated_at, slpa.associations, binarycontents AS content FROM dv_agent_skill_files AS slpr LEFT OUTER JOIN dv_skill_associations AS slpa ON slpr.external_element_id = slpa.parent_external_element_id ;

CHOWN admin VIEW dv_skill_metadata_impl LASTMODIFICATIONUSER admin;

