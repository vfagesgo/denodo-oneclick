        )
        OUTPUTLIST ("cacheAtomicOperation", "cacheInvalidationMode", "cacheLoadOnError", "cacheLoadOnError_0", "dagElements", "dataSourceID", description, disabled, draft, "excludedViews", "handlerSection", id, "incrementalFieldSource", "jobConcurrencyLevel", "loadProcessName", name, "parameterizedQuery", "projectId", "projectName", "refreshImplicitSummaries", "refreshViewsOnError", "reportSection", "retrySection", "sourcesNotChange", "triggerConditionSection", "triggerSection", type, type_0, "viewName"
        )
        WRAPPER (json ds_scheduler_api)
