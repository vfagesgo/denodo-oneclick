    FOLDER = '/01 - data sources'
    ROUTE HTTP 'http.ApacheHttpClientConnection,120000' GET '${databases.asset_extensions.folder.01 - data sources.datasources.json.ds_data_marketplace_openapi.ROUTE.HTTP.URL}'
    GENERATE_OUTPUT_ON_EMPTY_CONTENT
 AUTHENTICATION BASIC ( 
      USER '${databases.asset_extensions.folder.01 - data sources.datasources.json.ds_data_marketplace_openapi.ROUTE.HTTP.USER}'
      PASSWORD '${databases.asset_extensions.folder.01 - data sources.datasources.json.ds_data_marketplace_openapi.ROUTE.HTTP.PASSWORD}' ${databases.asset_extensions.folder.01 - data sources.datasources.json.ds_data_marketplace_openapi.ROUTE.HTTP.PASSWORD.ENCRYPTED} )
    PROXY OFF
    CHARSET = 'UTF-8';

CHOWN admin DATASOURCE JSON ds_data_marketplace_openapi LASTMODIFICATIONUSER admin;

