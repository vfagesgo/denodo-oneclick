# #######################################
# DATABASE
# #######################################
CONNECT DATABASE admin;

# #######################################
# RESOURCES
# #######################################
# No resources
# #######################################
# LISTENERS JMS
# #######################################
# No listeners jms
# #######################################
# LISTENERS KAFKA
# #######################################
# No listeners kafka
# #######################################
# DATASOURCES
# #######################################
CREATE OR REPLACE DATASOURCE JDBC vdpcachedatasource
    DRIVERCLASSNAME = 'org.postgresql.Driver'
    DATABASEURI = '${databases.admin.datasources.jdbc.vdpcachedatasource.DATABASEURI}'
    USERNAME = '${databases.admin.datasources.jdbc.vdpcachedatasource.USERNAME}'
    USERPASSWORD = '${databases.admin.datasources.jdbc.vdpcachedatasource.USERPASSWORD}' ${databases.admin.datasources.jdbc.vdpcachedatasource.USERPASSWORD.ENCRYPTED}
    CLASSPATH = 'postgresql'
    DATABASENAME = 'postgresql'
    DATABASEVERSION = '17'
    FETCHSIZE = 1000
    VALIDATIONQUERY = 'Select 1'
    INITIALSIZE = 4
    MAXIDLE = -1
    MINIDLE = 0
    MAXACTIVE = 20
    EXHAUSTEDACTION = 1
    TESTONBORROW = true
    TESTONRETURN = false
    TESTWHILEIDLE = false
    TIMEBETWEENEVICTION = -1
    NUMTESTPEREVICTION = 3
    MINEVICTABLETIME = 1800000
    POOLPREPAREDSTATEMENTS = false
    MAXOPENPREPAREDSTATEMENTS = -1
    PROPERTIES ('reWriteBatchedInserts'='true', 'escapeSyntaxCallMode'='callIfNoReturn', 'ApplicationName'='Denodo')
    KERBEROSPROPERTIES ('jaasLogin'='false', 'user'='<user>')
    DATA_LOAD_CONFIGURATION (
        USE_FOR_QUERY_OPTIMIZATION = DATA_MOVEMENT
        BATCHINSERTSIZE = 200
    )
    PROCESSING_UNITS = 1
    CPUS_PER_PROCESSING_UNIT = 1;

CHOWN admin DATASOURCE JDBC vdpcachedatasource LASTMODIFICATIONUSER admin;

CREATE OR REPLACE DATASOURCE JDBC vdpvectorialdatasource
    DRIVERCLASSNAME = 'org.postgresql.Driver'
    DATABASEURI = '${databases.admin.datasources.jdbc.vdpvectorialdatasource.DATABASEURI}'
    USERNAME = '${databases.admin.datasources.jdbc.vdpvectorialdatasource.USERNAME}'
    USERPASSWORD = '${databases.admin.datasources.jdbc.vdpvectorialdatasource.USERPASSWORD}' ${databases.admin.datasources.jdbc.vdpvectorialdatasource.USERPASSWORD.ENCRYPTED}
    CLASSPATH = 'postgresql'
    DATABASENAME = 'postgresql'
    DATABASEVERSION = '17'
    FETCHSIZE = 1000
    VALIDATIONQUERY = 'Select 1'
    INITIALSIZE = 4
    MAXIDLE = -1
    MINIDLE = 0
    MAXACTIVE = 20
    EXHAUSTEDACTION = 1
    TESTONBORROW = true
    TESTONRETURN = false
    TESTWHILEIDLE = false
    TIMEBETWEENEVICTION = -1
    NUMTESTPEREVICTION = 3
    MINEVICTABLETIME = 1800000
    POOLPREPAREDSTATEMENTS = false
    MAXOPENPREPAREDSTATEMENTS = -1
    PROPERTIES ('reWriteBatchedInserts'='true', 'escapeSyntaxCallMode'='callIfNoReturn', 'ApplicationName'='Denodo')
    KERBEROSPROPERTIES ('jaasLogin'='false', 'user'='<user>')
    DATA_LOAD_CONFIGURATION (
        BATCHINSERTSIZE = 200
    )
    PROCESSING_UNITS = 1
    CPUS_PER_PROCESSING_UNIT = 1;

CHOWN admin DATASOURCE JDBC vdpvectorialdatasource LASTMODIFICATIONUSER admin;

