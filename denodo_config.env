GITHUB_REPO=/vfagesgo/denodo-oneclick
# Default git branch to install from. Overridable with --branch <name> or the
# BRANCH env var. Note: for a piped `curl | bash` install, the very first fetch
# of this file uses install.sh's built-in default (or a CLI/env value), so a
# branch set only here applies to everything downstream but can't bootstrap the
# initial fetch of itself.
BRANCH=wip
DENODO_UTILS_URL=denodocommunity-resources/releases/download/v1.3.2/Denodo.Support.Utilities.v1.3.2.zip

DENODO_UPDATE=denodo-update-9.6.0-beta
DENODO_UPDATE_TARGET=beta-update
DENODO_PG_USER=denodo
DENODO_PG_PWD=password

DENODO_VDP_PWD=admin
