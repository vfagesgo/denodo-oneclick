[Unit]
Description=Denodo MCP Serice
After=local-fs.target systemd-remount-fs.service denodo-vdp-server.service
Requires=denodo-vdp-server.service
Wants=network-pre.target NetworkManager.service

[Service]
Type=simple
User=root
Group=root
MemoryMax=1G
ExecStartPre=/bin/sleep 90
TimeoutStartSec=120
ExecStart=/opt/denodo/denodo-mcp-server/bin/denodo-mcp-server.sh

RemainAfterExit=yes


[Install]
WantedBy=multi-user.target
