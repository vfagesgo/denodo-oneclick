[Unit]
Description=Denodo AISDK and Chatbot
After=local-fs.target systemd-remount-fs.service denodo-data-marketplace.service
Requires=denodo-data-marketplace.service
Wants=network-pre.target NetworkManager.service

[Service]
Type=simple
User=denodo
Group=denodo
MemoryMax=1G
WorkingDirectory=/opt/denodo/denodo-aisdk

ExecStartPre=/bin/sleep 120
TimeoutStartSec=180
ExecStart=//opt/denodo/denodo-mcp-server/bin/denodo-mcp-server.sh

RemainAfterExit=yes

Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
